# 外挂版 SWE-bench Verified 评测——被测 PayasoAgent 的模型配置。
# 评测器不 import agent，只把这些值作为 --env-file 喂给每次 spawn 的 agent CLI
# （agent CLI 的 env 兜底读 OPENAI_*）。默认用 step-5-preview：

OPENAI_BASE_URL=https://api.stepfun.com/step_plan/v1
OPENAI_API_KEY=
OPENAI_MODEL=step-5-preview

# 可选：被测 agent 的权限档 / 网络档（默认 workspace-write / on）
# EVAL_PERMISSION_MODE=workspace-write
# EVAL_NETWORK_MODE=on

# 可选：单实例 agent 墙钟上限（毫秒）。默认 3600000（60min）。timeout 不参与判分，
# 只作为过程标签记录（§5.4 v1.2）——超时的 diff 仍照常过 policy+apply 后提交。
# EVAL_INSTANCE_TIMEOUT_MS=3600000

# 可选：路径覆盖（默认都在 eval/ 下，且均已 gitignore）
# EVAL_SWEBENCH_CACHE=<数据集+repo clone 缓存，默认 eval/.cache>
# EVAL_OUTPUT_ROOT=<评测产物，默认 eval/runs>
# EVAL_AI_HOME=<被测 agent 的隔离 PAYASO_HOME，默认 eval/.ai-home>
# EVAL_ENV_FILE=<喂给 agent CLI 的 envfile，默认 eval/.env>
