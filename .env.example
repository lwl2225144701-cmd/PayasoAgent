# LLM 接入配置（OpenAI 兼容端点）
# Host 启动时若设置面板中从未导入过模型配置，会把这里的三项一次性导入设置并设为默认；
# 之后模型配置一律以设置面板为准（删除导入的 Provider 也不会再自动导入）。
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-xxx
OPENAI_MODEL=gpt-4o-mini

# 可选：按当前模型/服务商显式配置。未配置时 Runtime 尝试内置能力表，
# 未命中则使用窗口 fallback 256K + 输出预留按窗口推导（窗口 8%，夹在 4K–32K）。
# MODEL_CONTEXT_WINDOW_TOKENS=512000
# MODEL_MAX_OUTPUT_TOKENS=16384
# MODEL_CONTEXT_SAFETY_TOKENS=10240

# 可选：LLM 分层超时（毫秒，docs/long-task-timeout-plan.md 步骤 2）。
# 不再有"单请求总超时"——持续输出的长生成不会被掐断：
# - 连接超时：请求发出到响应头返回（覆盖 TCP/TLS/排队挂死）。默认 30000。
# - 空闲看门狗：流式事件间最大空档（prefill 首 token 等待计入；收到数据即续期）。默认 120000。
# 二者均不自动重试（超时不是瞬时错误），低于 1s 的配置会被抬到 1s。
# PAYASO_LLM_CONNECT_TIMEOUT_MS=30000
# PAYASO_LLM_IDLE_TIMEOUT_MS=120000

# 可选：工具级超时预算（毫秒，docs/long-task-timeout-plan.md 步骤 3）。
# 未声明 timeoutMs 的工具执行默认预算；到期返回结构化 TOOL_TIMEOUT（不重试）。
# 默认 300000（5 分钟），上限默认 3600000（1 小时）。
# PAYASO_TOOL_TIMEOUT_MS=300000
# PAYASO_TOOL_TIMEOUT_MAX_MS=3600000

# 可选：关闭 OpenAI-compatible SSE 流式响应，回退为完整 JSON 响应。默认启用。
# LLM_STREAMING=0

# 可选：shell 工具超时策略（毫秒）。默认 120000，模型可用 timeoutMs 请求更长时间；
# 上限默认 600000，超出范围会被收敛。低于 1s 的请求会被抬到 1s。
# PAYASO_SHELL_TIMEOUT_MS=120000
# PAYASO_SHELL_TIMEOUT_MAX_MS=600000

# 可选：shell 的 HOME/TMPDIR scratch 根目录。
# macOS 默认 /tmp/payaso-shell（即 /private/tmp/payaso-shell）——刻意选短路径，
# 因为 TMPDIR 会成为子进程 Unix socket（AF_UNIX 上限 108 字节）与测试 mkdtemp 的
# 基路径；曾因落在 /var/folders 深层路径（113B）导致 tsx listen EINVAL。
# 该目录在 Read Only 模式下仍可写（npm/npx/git 缓存），工作区保持只读。
# PAYASO_SHELL_SCRATCH_ROOT=/absolute/path/to/scratch

# 可选：非 macOS 平台允许无沙箱 shell（默认关闭，fail-closed）。仅在你明确接受风险时设置。
# PAYASO_SHELL_UNSANDBOXED=1

# 可选：Host 持久化数据库（sessions/runs/events）。默认项目内 .data/payaso.db
# PAYASO_DB_PATH=/absolute/path/to/payaso.db
