node_modules/
.env
.env.*
!.env.example
.DS_Store
.workbuddy/
.checkpoints/
# 压测现场日志（保留本地，不进版本库）
.stress-logs/
# Sandbox 工作区：按 runId 隔离，运行时生成的内容不进版本库；保留目录占位
sandbox/workspaces/*
!sandbox/workspaces/.gitkeep
# 前端构建产物
web/dist/
*.tsbuildinfo
# Trae IDE 产物目录
.trae/
# 本地 SQLite 持久化数据（放项目内可绕过 HOME 目录沙箱）
.data/

# 确定性套件运行日志（run-all 落盘，复查失败用；保留本地，不进版本库）
.payaso/logs/

# 会话运行期附件落盘（内容寻址存储硬链接进工作区 input/attachments/）
input/

# JetBrains IDE 产物目录
.idea/
docs/archify/*.png
docs/archify/*.visual-check.*
