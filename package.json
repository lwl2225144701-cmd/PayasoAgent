{
  "name": "payaso-agent",
  "version": "2.2.0",
  "description": "PayasoAgent: LLM-driven tool-calling agent runtime with Host API (HTTP+SSE) and React Web UI",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "npm run build:web && npm run host",
    "cli": "tsx --env-file=.env src/cli.ts",
    "test": "tsx --env-file=.env tests/agent.test.ts",
    "test:all": "tsx tests/run-all.ts",
    "test:baseline": "node --env-file=.env --import tsx tests/baseline/run.ts",
    "test:delivery": "node --env-file=.env --import tsx tests/task-delivery-e2e.test.ts",
    "test:stress": "tsx --env-file=.env tests/stress.test.ts",
    "test:sandbox": "tsx tests/sandbox-manager.test.ts",
    "test:contract": "tsx tests/tool-contract.test.ts",
    "test:model-selection": "tsx tests/model-selection.test.ts",
    "test:tools": "tsx tests/filesystem-tools.test.ts",
    "test:operation-identity": "tsx tests/operation-identity.test.ts",
    "test:side-effect": "tsx tests/side-effect.test.ts",
    "test:workspace": "tsx tests/workspace.test.ts",
    "host": "tsx --env-file=.env src/host/index.ts",
    "test:host": "tsx --env-file=.env tests/host.test.ts",
    "dev:web": "cd web && npm run dev",
    "build:web": "cd web && npm run build",
    "dev": "concurrently -n host,web -c blue,green \"npm run host\" \"npm run dev:web\"",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "setup": "npm ci && npm ci --prefix web",
    "build:server": "tsc -p tsconfig.build.json && node scripts/copy-runtime.mjs",
    "build": "npm run build:server && npm run build:web && node scripts/generate-notices.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/node": "^26.2.0",
    "concurrently": "^9.2.4",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@deepseek-ai/dsh-sandbox-windows-acl": "0.1.5-rc.2",
    "@earendil-works/pi-ai": "^0.85.1",
    "sharp": "^0.35.4"
  },
  "bin": {
    "payaso-agent": "bin/payaso.cjs"
  },
  "files": [
    "bin/",
    "dist/",
    "web/dist/",
    "THIRD_PARTY_NOTICES.md"
  ]
}
