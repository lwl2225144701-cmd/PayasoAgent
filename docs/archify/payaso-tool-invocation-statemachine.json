    { "id": "e17", "from": "auth_pending", "to": "denied", "label": "deny", "variant": "security", "role": "error", "fromSide": "left", "toSide": "left", "route": "return-left", "labelSegment": 1 },
    { "id": "e18", "from": "executing", "to": "aborted", "label": "取消", "variant": "security", "role": "error", "fromSide": "left", "toSide": "top", "route": "drop", "labelSegment": 2 }
  ],
  "cards": [
    { "dot": "cyan", "title": "22 phase 封闭转移表", "items": ["12非终态 + 10终态；终态出边为空集（图仅绘制主链）", "transitionToolInvocation()：非法转移抛 Illegal transition", "history 追加式记录完整路径，纯函数可独立测试", "ProcessManager 拥有副作用，本模块只拥有合法顺序"] },
    { "dot": "rose", "title": "图上未绘制的合法转移", "items": ["invalid ← received/parsed/resolved/validated 任一段失败", "aborted ← 7个非终态均可直达（万能逃生门），图中仅绘 executing 例", "effect_checked 还可直达 failed/aborted；intent 落盘失败也入 failed", "denied 亦可从 executing 到达（执行期撤权）"] },
    { "dot": "violet", "title": "分组终态", "items": ["effect_unknown = uncertain + blocked(未知副作用) + replayed(幂等回放)", "failed 组另含 timed_out / invalid_result（仅 executing 可达）", "终态封闭：一旦进入不再转出", "invalid_result：执行完成但结果校验无效"] },
    { "dot": "emerald", "title": "崩溃安全与恢复环", "items": ["intent_persisting→persisted：先落盘写意图再执行", "崩溃后已persisted未确认效果 → uncertain，绝不盲目重放", "唯一重入环 executing→dep_preparation→retry_wait→executing", "retry_wait 仅3出边：executing/failed/aborted，受工具级 deadline 约束"] }
  ]
