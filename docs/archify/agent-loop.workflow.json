  "cards": [
    {
      "dot": "cyan",
      "title": "主循环怎么转",
      "items": [
        "没有固定迭代上限：模型持续调工具就一直转",
        "终止只由收尾 / 取消 / 工具安全 / Harness 策略决定",
        "每轮 prepareTurn 重建模型视图，transcript 永不改写",
        "后台作业完成时伪造 user 消息，防止模型干等收尾"
      ]
    },
    {
      "dot": "rose",
      "title": "护栏怎么兜",
      "items": [
        "副作用操作先持久化 intent 再执行，persist 失败就禁跑",
        "已成功的操作回放结果，结果不确定的永久阻断",
        "失败消息带指令回传：禁止同参数重试，教它换方法",
        "空回合 / 未完成行动句各给有限 nudge，超限 fail loudly"
      ]
    },
    {
      "dot": "emerald",
      "title": "为什么这样设计",
      "items": [
        "模型是不可信输入源：幻觉参数、绕黑名单、装死都要兜",
        "每类不可信行为对应一个确定性 Runtime 机制",
        "所有恢复预算有界，burn 完就落 failed 可 resume",
        "智能决策权留给模型，安全边界握在 Runtime"
      ]
    }
  ]
