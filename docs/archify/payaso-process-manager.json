  "cards": [
    { "dot": "cyan", "title": "进管三关（invocation error）", "items": ["parseToolArguments：malformed 绝不执行、不建副作用", "getTool 未知工具 → 结构化错误回传模型自修正", "Schema 校验：未知/缺失/类型错显式回传，绝不静默丢弃", "三关失败均走 pushToolCallError，不进执行重试（模型修正≠瞬态重试）"] },
    { "dot": "rose", "title": "三道安全门", "items": ["JIT审批(ask+网络)：拒绝→denied 审计，不建副作用、不重试", "副作用门(仅 non_idempotent)：succeeded→replayed 回放；executing/uncertain→拦截不伪造", "resolveToolEffect 按本次调用解析：shell 只读命令不再被回放缓存", "防死循环：canonical input 相同 tool+参数失败>MAX_RETRY(2)→blocked"] },
    { "dot": "violet", "title": "意图保护与 deadline", "items": ["non_idempotent：begin+save(executing) 失败→禁止 execute 直接 throw", "effectiveRetries：幂等=2 / non_idempotent=0（首次失败即 uncertain 交 LLM）", "v2.3 deadline：Tool.timeoutMs 或全局默认；TimeoutAbortError≠用户 AbortError", "shell 沙箱事件经 onSandboxEvent 全程入 trace"] },
    { "dot": "emerald", "title": "结果面与失败面", "items": ["执行成功≠结果有效：validateResult 看完整 raw；guard 后一切入库内容受限", "invalid_result：不进 completedSteps、单独计数、恢复消息回传", "classifyToolError：确定性错误（缺文件/越界/参数非法/策略拒绝）不重试", "abort 终态：save 保现场后 throw，Host 落 stopped——不重试不写恢复消息", "dep_prep 闭环：缺可执行→Host 受控安装+refreshToolchain，原命令不自动重试"] }
  ]
