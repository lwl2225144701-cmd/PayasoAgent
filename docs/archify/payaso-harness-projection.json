    { "id": "e3", "from": "v_views", "to": "p_view", "label": "sp/plan文本", "variant": "default", "role": "branch", "fromSide": "bottom", "toSide": "top", "route": "drop", "labelSegment": 1 },
    { "id": "e4", "from": "p_view", "to": "p_trim", "label": "process()", "variant": "emphasis" },
    { "id": "e5", "from": "v_tools", "to": "p_trim", "label": "schema费", "variant": "default", "role": "branch", "fromSide": "bottom", "toSide": "top", "route": "drop", "labelSegment": 1 },
    { "id": "e6", "from": "p_trim", "to": "p_trig", "variant": "emphasis" },
    { "id": "e7", "from": "p_trig", "to": "x_prepared", "label": "未超", "variant": "emphasis", "fromSide": "bottom", "toSide": "top", "route": "drop", "labelSegment": 1 },
    { "id": "e8", "from": "p_trig", "to": "c_sum", "label": "超预算", "variant": "default", "role": "branch", "fromSide": "bottom", "toSide": "top", "route": "drop", "labelSegment": 1 },
    { "id": "e9", "from": "c_sum", "to": "s_state", "label": "增量合并", "variant": "default", "role": "return" },
    { "id": "e10", "from": "c_sum", "to": "r_emergency", "label": "仍超", "variant": "security", "role": "error", "fromSide": "bottom", "toSide": "top", "route": "drop", "labelSegment": 1 },
    { "id": "e11", "from": "r_emergency", "to": "x_prepared", "label": "视图有界", "variant": "default", "role": "branch", "fromSide": "right", "toSide": "top" },
    { "id": "e12", "from": "r_emergency", "to": "x_fail", "label": "兜底耗尽", "variant": "security", "role": "error", "fromSide": "bottom", "toSide": "top", "route": "drop", "labelSegment": 1 }
  ],
  "cards": [
    { "dot": "cyan", "title": "system 段预算与缓存", "items": ["kernel.base 永不丢弃（宁可超预算也保规则）", "静态段在前，最大化 prompt cache 命中", "动态段每轮刷新：toolchain/network/env", "system 总预算 = 15% 窗口（下限 512 tok）"] },
    { "dot": "rose", "title": "修剪与估算", "items": ["轮为原子单位：user→…→下一 user 整体保留或移除", "永远保留 system + 当前任务轮", "估算 = JSON 结构 + 角色开销 + 图片 tile 定价", "先扣 ToolSchema 费，消息预算 = 目标 − schema"] },
    { "dot": "violet", "title": "压缩阈值", "items": ["触发 = 修剪前原始估值 > 80% 窗口（防修剪自掩盖）", "目标 65%：留出 system 增长余量防再触发", "摘要预算 = 8% 窗口，夹在 128–4096 tok", "摘要失败 fail-soft 保留裁剪；overBudget 仍 fail-closed"] },
    { "dot": "emerald", "title": "兜底与状态", "items": ["紧急裁剪：当前轮从最旧逐条丢弃，保最近 2→1→0（85% 目标）", "canonical transcript 永不改写——摘要即逻辑删除", "snapshotState/restoreState 进 Checkpoint，resume 走同一路径", "返回 usage/scratchpadTokens/planTokens 供 trace 计量"] }
  ]
}
