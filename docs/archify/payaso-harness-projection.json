  },
  "lanes": [
    { "id": "views", "label": "输入投影" },
    { "id": "pipe", "label": "组装与修剪" },
    { "id": "compact", "label": "压缩与状态" },
    { "id": "guard", "label": "紧急兜底" },
    { "id": "exit", "label": "输出/终态", "variant": "exception" }
  ],
  "phases": [
    { "id": "compose", "label": "组装", "fromCol": 0, "toCol": 1 },
    { "id": "trim", "label": "修剪/判定", "fromCol": 2, "toCol": 3, "variant": "emphasis" },
    { "id": "compactact", "label": "压缩/兜底", "fromCol": 4, "toCol": 5, "variant": "dashed" }
  ],
  "mainPath": ["p_sys", "p_view", "p_trim", "p_trig", "x_prepared"],
  "nodes": [
    { "id": "v_transcript", "lane": "views", "col": 0, "type": "external", "label": "transcript", "sublabel": "role过滤·图仅path" },
    { "id": "v_views", "lane": "views", "col": 2, "type": "backend", "label": "有界视图", "sublabel": "sp 3%≤2K·plan≤300" },
    { "id": "v_tools", "lane": "views", "col": 4, "type": "database", "label": "ToolSchema", "sublabel": "schema计费优先" },
    { "id": "p_sys", "lane": "pipe", "col": 0, "type": "backend", "label": "system段组装", "sublabel": "静态在前·两段预算" },
    { "id": "p_view", "lane": "pipe", "col": 1, "type": "cloud", "label": "视图组装", "sublabel": "buildModelView" },
    { "id": "p_trim", "lane": "pipe", "col": 3, "type": "security", "label": "轮边界修剪", "sublabel": "整轮原子·保当前轮" },
    { "id": "p_trig", "lane": "pipe", "col": 5, "type": "security", "label": "80%判定", "sublabel": "修剪前估值" },
    { "id": "c_sum", "lane": "compact", "col": 3, "type": "cloud", "label": "LLM摘要", "sublabel": "65%目标·8%≤4096" },
    { "id": "s_state", "lane": "compact", "col": 1, "type": "database", "label": "Harness状态", "sublabel": "summary+count+plan" },
    { "id": "r_emergency", "lane": "guard", "col": 1, "type": "security", "label": "紧急裁剪", "sublabel": "保最近2→1→0条" },
    { "id": "x_prepared", "lane": "exit", "col": 5, "type": "cloud", "label": "PreparedTurn", "sublabel": "messages+usage+摘要明细" },
    { "id": "x_fail", "lane": "exit", "col": 0, "type": "security", "label": "fail-closed", "sublabel": "仍overBudget抛错" }
